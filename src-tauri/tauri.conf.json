{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OUTPOST",
  "version": "0.1.0",
  "identifier": "io.github.outpost-chess",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OUTPOST — Chess Analysis",
        "width": 1480,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Game",
    "shortDescription": "Local-first chess analysis studio",
    "longDescription": "OUTPOST is a free, open-source, local-first chess analysis studio with a built-in Stockfish, game review, tactics generated from your own games, and optional AI explanations.",
    "license": "GPL-3.0-or-later AND AGPL-3.0-or-later",
    "copyright": "OUTPOST contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {},
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    }
  }
}
